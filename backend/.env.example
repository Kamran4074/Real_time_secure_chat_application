# Copy to .env and fill in. Never commit .env.

PORT=3000
MONGODB_CONNECT=mongodb://localhost:27017/chatapp
# at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# production on Render: set NODE_ENV=production for JSON logs
NODE_ENV=development
# error | warn | info | debug (default: debug locally, info in production)
LOG_LEVEL=
# json | pretty (default: json in production, pretty locally)
LOG_FORMAT=

# Frontend origins allowed by CORS (comma-separated)
CLIENT_ORIGINS=http://localhost:5173,https://chatwave-azure.vercel.app

# ---- OAuth 2.0 (optional: a provider's button turns on when both its values are set) ----
# Public URL of this backend. Register <SERVER_URL>/api/auth/<provider>/callback with each provider.
SERVER_URL=http://localhost:3000
# Where users land after signing in (must be one of CLIENT_ORIGINS)
CLIENT_URL=http://localhost:5173

# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
